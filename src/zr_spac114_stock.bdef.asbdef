managed implementation in class zbp_r_spac114_stock unique;
strict ( 2 );

define behavior for ZR_SPAC114_STOCK alias Stock
persistent table zspac114_stock
lock master
authorization master ( instance )
//etag master <field_name>
{
  create ( authorization : global );
  update;
  delete;
  field ( readonly ) WarehouseId, ProductId;

  mapping for zspac114_stock corresponding
    {
      WarehouseId = warehouse_id;
      ProductId   = product_id;
    }
}